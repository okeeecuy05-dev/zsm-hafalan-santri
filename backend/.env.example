APP_NAME="ZSM Hafalan Santri API"
# development | production  (production menolak JWT_SECRET bawaan/lemah)
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zsm_hafalan
CORS_ORIGINS=["http://localhost:3000"]
TIMEZONE=Asia/Jakarta
AUTO_CREATE_TABLES=true
DB_ECHO=false

# Rahasia penanda sesi login. WAJIB diganti di produksi. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-rahasia-ini-di-produksi-minimal-32-karakter
JWT_EXPIRE_HOURS=720

# Alamat frontend; dipakai untuk membuat tautan masuk (Magic Link) dan QR
FRONTEND_BASE_URL=http://localhost:3000

# Analitik
ANALITIK_JENDELA_HARI=30
MELAMBAT_AMBANG=0.5
MELAMBAT_MIN_HARI_DATA=14
